# Base image with CUDA for GPU support
FROM nvidia/cuda:12.4.0-base-ubuntu22.04

LABEL maintainer="Olawale Adekoya <olawaley2k@gmail.com>"

ENV DEBIAN_FRONTEND=noninteractive \
    PYENV_ROOT="/root/.pyenv" \
    POETRY_HOME="/opt/poetry"

# 🧱 System dependencies & build tools
RUN apt-get update && apt-get install -y \
    build-essential curl wget git gcc make openssl libssl-dev \
    libbz2-dev libreadline-dev libsqlite3-dev zlib1g-dev \
    libncursesw5-dev libgdbm-dev libc6-dev tk-dev \
    lzma liblzma-dev libffi-dev python3 python3-pip python3-venv \
    gcc-11 g++-11 && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-11 100 && \
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-11 100

# 🔧 Pyenv setup (Python 3.11)
RUN curl https://pyenv.run | bash
ENV PATH="$PYENV_ROOT/bin:$PATH"
RUN bash -c "eval \"$(pyenv init -)\" && pyenv install 3.11 && pyenv global 3.11"

# 🚀 Poetry installation
RUN curl -sSL https://install.python-poetry.org | python3 - && \
    ln -s $POETRY_HOME/bin/poetry /usr/local/bin/poetry
ENV PATH="$POETRY_HOME/bin:$PATH"

# 🧠 Clone PrivateGPT repo
WORKDIR /app
RUN git clone https://github.com/imartinez/privateGPT.git
WORKDIR /app/privateGPT

# 📚 Install dependencies with CUDA + LLaMA bindings
RUN poetry config virtualenvs.in-project true && \
    poetry install --extras "ui embeddings-huggingface llms-llama-cpp vector-stores-qdrant"

# 🔩 Force LLaMA CUDA build
ENV CMAKE_ARGS="-DLLAMA_OPENBLAS=on" \
    FORCE_CMAKE=1
RUN poetry run pip install --force-reinstall --no-cache-dir llama-cpp-python

# 🧪 Setup & build models
RUN poetry run python scripts/setup

# 🌐 Expose web interface
EXPOSE 8001

# 🧮 Entrypoint
CMD ["make", "run"]
