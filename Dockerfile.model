FROM nvidia/cuda:12.4.0-base-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    POETRY_VERSION=1.8.2 \
    CMAKE_ARGS="-DLLAMA_OPENBLAS=on" \
    FORCE_CMAKE=1 \
    PATH="/root/.local/bin:$PATH"

# 🧱 System dependencies + Python 3.11
RUN apt-get update && apt-get install -y \
    software-properties-common curl wget git build-essential gcc g++ make \
    openssl libssl-dev libbz2-dev libreadline-dev libsqlite3-dev zlib1g-dev \
    libncursesw5-dev libgdbm-dev tk-dev lzma liblzma-dev libffi-dev \
    gcc-11 g++-11 && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y python3.11 python3.11-venv python3.11-distutils && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    curl -sS https://bootstrap.pypa.io/get-pip.py | python && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-11 100 && \
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-11 100

# 🎼 Poetry installation
RUN pip3 install --no-cache-dir poetry==${POETRY_VERSION}

# 📂 Clone PrivateGPT repo
WORKDIR /app
RUN git clone https://github.com/imartinez/privateGPT.git
WORKDIR /app/privateGPT

# 📜 Copy runtime setup script
COPY .script/startup.sh /app/privateGPT/.script/startup.sh

# 📦 Install dependencies with extras
RUN poetry config virtualenvs.in-project true && \
    poetry install --extras "ui embeddings-huggingface llms-llama-cpp vector-stores-qdrant"

# 🧠 Install LLaMA CUDA bindings
RUN poetry run pip install --force-reinstall --no-cache-dir llama-cpp-python

EXPOSE 8001

CMD ["poetry", "run", "make", "run"]
